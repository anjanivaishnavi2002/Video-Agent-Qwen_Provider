# Copy to `.env` next to docker-compose.yml. Never commit the real .env.
# Values containing $ or special characters in URLs must be escaped/URL-encoded.

# ---------- Images (set on the VM; the deploy workflow updates TAG) ----------
REGISTRY=europe-west1-docker.pkg.dev/YOUR_PROJECT/video-agent
TAG=latest

# ---------- Public address ----------
# Domain with DNS pointing at the VM -> automatic HTTPS. Use :80 for plain HTTP tests.
SITE_ADDRESS=interview.example.com

# ---------- Database (Cloud SQL through the proxy container) ----------
CLOUDSQL_INSTANCE=YOUR_PROJECT:europe-west1:video-agent-db
CLOUDSQL_FLAGS=--private-ip
DATABASE_URL=postgresql+psycopg2://video_agent:URL_ENCODED_PASSWORD@cloudsql-proxy:5432/video_agent

# ---------- File storage (Cloud Storage) ----------
STORAGE_BACKEND=gcs
GCS_BUCKET=your-video-agent-bucket
GCS_PREFIX=video-agent

# ---------- Security ----------
# Recruiters read results with:  curl -H "X-API-Key: <this>" https://<domain>/api/session/<id>/result
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM
CORS_ORIGINS=https://interview.example.com

# ---------- AI models ----------
# Production uses Vertex AI Gemini with the VM's service account - there is no API key.
LLM_PROVIDER=vertex
VERTEX_PROJECT_ID=YOUR_PROJECT
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
WHISPER_MODEL=base
# Everything else (interview length, silence timeout, tone, ...) is in backend/.env.example
