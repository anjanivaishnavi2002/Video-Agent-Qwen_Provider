# =====================================================================================================
# Interview backend - LOCAL DEVELOPMENT configuration.   cp .env.example .env     (.env is git-ignored)
# Production does NOT use a .env file: values come from Cloud Run env vars + Secret Manager
# (see docs/DEPLOYMENT.md). Never commit real credentials. There is no API key setting anywhere:
# Gemini is reached through Vertex AI with Application Default Credentials.
# =====================================================================================================

ENVIRONMENT=development                # development | production (production enables strict safety checks)
LOG_LEVEL=INFO
LOG_FORMAT=text                        # json on Cloud Run

# ---------- Database (PostgreSQL) ----------
# Local Postgres or docker-compose.dev.yml:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/video_agent
# Cloud SQL from Cloud Run (unix socket, set from Secret Manager):
#   postgresql+psycopg2://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
AUTO_CREATE_SCHEMA=true                # dev only: create tables on start. Production: `alembic upgrade head`

# ---------- AI: Gemini on Vertex AI ----------
LLM_PROVIDER=gemini                    # gemini (Vertex AI) | ollama (offline dev)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash       # text model: resume analysis, scoring, summaries
# Real-time voice interview (Gemini Live). The Live API is served from fewer regions than text models.
INTERVIEW_MODE=live                    # live | turn (turn = legacy Whisper -> text model -> Piper)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_LOCATION=us-central1
GEMINI_LIVE_VOICE=Aoede
ENABLE_OLLAMA=false                    # Qwen/Ollama stays disabled
# Local auth: run once   gcloud auth application-default login
# Production auth: the Cloud Run service account (roles/aiplatform.user). No key file, no API key.
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

# ---------- Admin authentication ----------
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_TOKEN_EXPIRE_MINUTES=60
# Create the first admin with:  python -m scripts.create_admin --email you@company.com
# (or set both of these ONCE for a first start, then remove them)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_API_KEY=                         # legacy; leave empty

# ---------- Interview settings ----------
INTERVIEWER_NAME=Alex
INTERVIEWER_TONE=warm, professional and conversational
INTERVIEW_TYPE=BPO / customer operations hiring
INTERVIEW_DURATION_MINUTES=15
MAX_TURNS=25
MAX_INTERVIEW_ATTEMPTS=3

# ---------- Web ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173      # the frontend origin(s) only, never *
FRONTEND_BASE_URL=http://localhost:5173
ENABLE_DEBUG_ENDPOINTS=false

# ---------- Files ----------
STORAGE_BACKEND=local                  # local | gcs   (production: gcs)
GCS_BUCKET_NAME=                       # private bucket, e.g. my-project-interview-files
GCS_PREFIX=video-agent
GCS_SIGNING_SERVICE_ACCOUNT=           # Cloud Run service account e-mail (signed URLs)
SIGNED_URL_TTL_SECONDS=600
UPLOAD_DIR=uploads
MAX_RESUME_MB=10
MAX_VIDEO_MB=500

# ---------- Notification service ----------
NOTIFICATIONS_ENABLED=true
NOTIFICATION_SERVICE_URL=http://localhost:8081    # empty = notifications are recorded as "skipped"
NOTIFICATION_SERVICE_TOKEN=change-me-local-only   # must equal NOTIFICATION_API_TOKEN of the notification service
NOTIFICATION_AUTH_MODE=token                       # token | iam | both (Cloud Run: both)

# ---------- Consent form ----------
ORGANIZATION_NAME=Your Company
DATA_RETENTION_DAYS=90
CONSENT_CONTACT_EMAIL=privacy@example.com

# ---------- Voice (runs inside the backend container) ----------
PRELOAD_MODELS=false
WHISPER_MODEL=base
