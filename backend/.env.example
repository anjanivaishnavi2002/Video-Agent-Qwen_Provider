# Copy to backend/.env for local development. NEVER commit the real .env (it is git-ignored).

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/video_agent

# ---------- AI model (self-hosted Qwen via Ollama; voice: Whisper -> Qwen -> Piper) ----------
# Install Ollama locally and run:  ollama pull qwen2.5:3b-instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# ---------- Interview settings ----------
INTERVIEWER_NAME=Alex
INTERVIEWER_TONE=warm, professional and conversational
INTERVIEW_TYPE=BPO / customer operations hiring
INTERVIEW_DURATION_MINUTES=15
MAX_TURNS=25

# ---------- Web ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Storage / security ----------
STORAGE_BACKEND=local
ADMIN_API_KEY=
ENABLE_DEBUG_ENDPOINTS=true

# ---------- Consent form ----------
ORGANIZATION_NAME=AnjaniVaishnavi
DATA_RETENTION_DAYS=90
CONSENT_CONTACT_EMAIL=privacy@example.com
