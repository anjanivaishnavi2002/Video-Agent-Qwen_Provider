# ---------- Database ----------
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/video_agent

# ---------- LLM: Google Gemini Developer API ----------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# ---------- Interview Settings ----------
INTERVIEWER_NAME=Alex
INTERVIEWER_TONE=warm, professional and conversational
INTERVIEW_TYPE=BPO / customer operations hiring
INTERVIEW_DURATION_MINUTES=15
MAX_TURNS=25

# ---------- Web ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Deployment / Storage ----------
STORAGE_BACKEND=local              # local | gcs
GCS_BUCKET=
GCS_PREFIX=video-agent
ADMIN_API_KEY= # Production lo secure ga undadaniki
ENABLE_DEBUG_ENDPOINTS=true
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_SECONDS=2

# ---------- Consent form ----------
ORGANIZATION_NAME=AnjaniVaishnavi
DATA_RETENTION_DAYS=90
CONSENT_CONTACT_EMAIL=privacy@example.com