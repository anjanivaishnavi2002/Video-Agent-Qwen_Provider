# Copy to .env. Only DATABASE_URL is required - everything else has a default in app/config.py.
# If your password has special characters, URL-encode them (@ -> %40).
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/video_agent

# ---------- LLM (Qwen through Ollama) ----------
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.7
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=400
LLM_KEEP_ALIVE=30m

# ---------- Interview ----------
INTERVIEWER_NAME=Priya
INTERVIEWER_TONE=warm, professional and conversational
INTERVIEW_TYPE=BPO / customer operations hiring
INTERVIEW_DURATION_MINUTES=15
MAX_TURNS=25
MIN_TURNS_BEFORE_END=4
HISTORY_TURNS_IN_PROMPT=10
MAX_EMPTY_STREAK=3
EMPTY_BEFORE_REPROMPT=1
DEBUG_EXPOSE_TEXT=false          # true = API also returns interviewer/candidate text (debugging only)
# BPO guidance the interviewer uses: edit app/prompts/bpo_context.yaml
# Interviewer instructions:         edit app/prompts/interviewer.yaml

# ---------- Resume ----------
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx,.txt
MAX_RESUME_MB=10
MIN_RESUME_CHARS=80
RESUME_STORE_MAX_CHARS=60000
RESUME_PROMPT_MAX_CHARS=6000     # longer resumes are analysed in chunks and merged
RESUME_CHUNK_CHARS=5000

# ---------- Files / recording ----------
UPLOAD_DIR=uploads
RESUME_SUBDIR=resumes
VIDEO_SUBDIR=videos
ALLOWED_VIDEO_EXTENSIONS=.webm,.mp4
MAX_VIDEO_MB=500
VIDEO_BITS_PER_SECOND=800000

# ---------- Speech-to-text (Faster-Whisper) ----------
WHISPER_MODEL=base               # 'small' is noticeably better for Indian-accent English
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_VAD=true
WHISPER_VAD_THRESHOLD=0.3
WHISPER_VAD_MIN_SILENCE_MS=700
WHISPER_NO_SPEECH_THRESHOLD=0.85
WHISPER_MIN_LOGPROB=-1.5
STT_LANGUAGE=en
STT_MIN_AUDIO_SECONDS=0.4
PRELOAD_MODELS=false

# ---------- Text-to-speech (Piper) ----------
PIPER_VOICE_PATH=voices/en_US-lessac-medium.onnx

# ---------- Hands-free listening (sent to the browser) ----------
VAD_SILENCE_MS=1800              # silence that ends an answer (1500-2000 recommended)
VAD_MIN_SPEECH_MS=500
VAD_ONSET_MS=150
VAD_PREROLL_MS=500
VAD_MIN_THRESHOLD=0.012
VAD_NOISE_MULTIPLIER=3.0
VAD_MAX_NOISE_FLOOR=0.05
VAD_CALIBRATION_MS=300
VAD_MAX_UTTERANCE_MS=90000
VAD_NO_SPEECH_TIMEOUT_MS=20000   # 0 = never check in on a silent candidate
AUDIO_TARGET_SAMPLE_RATE=16000

# ---------- Face monitoring (observable events only) ----------
FACE_MAX_FACES=2
FACE_WASM_URL=/mediapipe/wasm
FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
FACE_MISSING_GRACE_MS=2000
FACE_MOVEMENT_THRESHOLD=0.06
FACE_MOVEMENT_WINDOW_MS=600
FACE_EVENT_COOLDOWN_MS=3000
FACE_EVENT_FLUSH_MS=5000
ALLOWED_EVENT_TYPES=face_missing,face_returned,multiple_faces,head_movement

# ---------- Web ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Deployment / security (see the root .env.example and README) ----------
STORAGE_BACKEND=local            # local | gcs  (gcs = Google Cloud Storage bucket)
GCS_BUCKET=
GCS_PREFIX=video-agent
ADMIN_API_KEY=                   # set in production: recruiters send it as X-API-Key to read results
ENABLE_DEBUG_ENDPOINTS=true      # raw /voice/stt + /voice/tts; set false in production
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_SECONDS=2

# ---------- Consent form (text: app/prompts/consent.yaml) ----------
ORGANIZATION_NAME=SriPragnyaTechnologies
DATA_RETENTION_DAYS=90
CONSENT_CONTACT_EMAIL=privacy@example.com
