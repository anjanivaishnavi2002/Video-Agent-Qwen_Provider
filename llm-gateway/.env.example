# LLM gateway: a provider is ON when its key is set. Keys go in Secret Manager in production, never in Git.
GATEWAY_API_TOKEN=change-me
REQUIRE_TOKEN=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Spread across providers by weight; GATEWAY_EXCLUDE removes a provider completely (e.g. for data-residency reasons)
GATEWAY_WEIGHTS=openai:1,anthropic:1,gemini_api:1,deepseek:1
GATEWAY_EXCLUDE=
