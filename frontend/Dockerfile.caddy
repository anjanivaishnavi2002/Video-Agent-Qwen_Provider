# Legacy single-VM image (Caddy + same-origin /api proxy). Cloud Run uses ./Dockerfile (nginx). See docker-compose.yml.
# syntax=docker/dockerfile:1.7

# ---- build the React app ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Same-origin API: the web server below proxies /api/* to the backend container.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# ---- serve it with Caddy (static files + /api reverse proxy + automatic HTTPS) ----
FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 80 443
