# Notification service - local development. Copy to .env (never commit .env).
ENVIRONMENT=development
LOG_FORMAT=text

# Shared secret: the interview backend sends the same value as NOTIFICATION_SERVICE_TOKEN.
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(32))"
NOTIFICATION_API_TOKEN=change-me-local-only
REQUIRE_TOKEN=true
ORGANIZATION_NAME=Your Company

# console = just log (default for local dev)  |  resend  |  smtp  |  sendgrid
# Resend: EMAIL_FROM must use a domain you verified in Resend (e.g. Recruiting <hr@yourdomain.com>)
EMAIL_PROVIDER=console
EMAIL_FROM=Recruiting <recruiting@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_REPLY_TO=

# console | twilio | msg91 (msg91 = India, DLT templates)
SMS_PROVIDER=console
# Phone calls (text-to-speech). console = log only; twilio = real calls (reuses TWILIO_* below)
VOICE_PROVIDER=console
TWILIO_VOICE_FROM_NUMBER=
VOICE_LANGUAGE=en-IN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_VAR=message
MSG91_COUNTRY_CODE=91
